{
  "name": "selfhosted-sentry-mcp",
  "version": "1.2.0",
  "description": "Model context protocol server for self-hosted Sentry instances with debugging tools.",
  "license": "MIT",
  "author": "hieuda",
  "homepage": "https://github.com/HieuAnh87/sentry-selfhosted-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HieuAnh87/sentry-selfhosted-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/HieuAnh87/sentry-selfhosted-mcp/issues"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "sentry",
    "self-hosted",
    "debugging"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "bin": {
    "selfhosted-sentry-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js",
    "test": "node --test test/**/*.test.js",
    "test:smoke": "node test/smoke.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "0.6.0",
    "axios": "^1.8.4"
  },
  "devDependencies": {
    "nock": "^14.0.10",
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3"
  }
}
